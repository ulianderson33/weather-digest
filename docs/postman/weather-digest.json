        {
          "name": "Bad Request 400 — отсутствует параметр name",
          "originalRequest": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrlGeo}}?count=1&language=ru&format=json",
              "host": ["{{baseUrlGeo}}"],
              "query": [
                { "key": "count", "value": "1" },
                { "key": "language", "value": "ru" },
                { "key": "format", "value": "json" }
              ]
