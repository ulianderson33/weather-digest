{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Weather Digest API",
    "description": "Коллекция для утилиты «Погодный дайджест». Два запроса: геокодинг (получение координат по названию города) и прогноз погоды (по координатам).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Geocoding — получить координаты города",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has results array', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('results');",
              "    pm.expect(json.results).to.be.an('array');",
              "});",
              "",
              "// Автоматически сохраняем координаты в переменные коллекции",
              "const json = pm.response.json();",
              "if (json.results && json.results.length > 0) {",
              "    pm.collectionVariables.set('lat', json.results[0].latitude);",
              "    pm.collectionVariables.set('lon', json.results[0].longitude);",
              "    console.log('Сохранены координаты:', json.results[0].latitude, json.results[0].longitude);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrlGeo}}?name={{city}}&count=1&language=ru&format=json",
          "host": ["{{baseUrlGeo}}"],
          "query": [
            { "key": "name", "value": "{{city}}" },
            { "key": "count", "value": "1" },
            { "key": "language", "value": "ru" },
            { "key": "format", "value": "json" }
          ]
        },
        "description": "Получает координаты (latitude, longitude) по названию города. Результат записывается в переменные {{lat}} и {{lon}}."
      },
      "response": [
        {
          "name": "Success 200 — город найден",
          "originalRequest": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrlGeo}}?name=Нижний Новгород&count=1&language=ru&format=json",
              "host": ["{{baseUrlGeo}}"],
              "query": [
                { "key": "name", "value": "Нижний Новгород" },
                { "key": "count", "value": "1" },
                { "key": "language", "value": "ru" },
                { "key": "format", "value": "json" }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            { "key": "Content-Type", "value": "application/json; charset=utf-8" }
          ],
          "cookie": [],
          "body": "{\n  \"results\": [\n    {\n      \"id\": 520555,\n      \"name\": \"Нижний Новгород\",\n      \"latitude\": 56.32694,\n      \"longitude\": 44.00599,\n      \"elevation\": 130.0,\n      \"feature_code\": \"PPLA\",\n      \"country_code\": \"RU\",\n      \"admin1_id\": 559838,\n      \"timezone\": \"Europe/Moscow\",\n      \"population\": 1259013,\n      \"country_id\": 2017370,\n      \"country\": \"Russia\",\n      \"admin1\": \"Нижегородская область\"\n    }\n  ],\n  \"generationtime_ms\": 0.85\n}"
        },
