    },
    {
      "name": "2. Forecast — прогноз по координатам",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has daily block', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('daily');",
              "    pm.expect(json.daily).to.have.property('time');",
              "    pm.expect(json.daily).to.have.property('temperature_2m_max');",
              "    pm.expect(json.daily).to.have.property('temperature_2m_min');",
              "    pm.expect(json.daily).to.have.property('precipitation_sum');",
              "});",
              "",
              "pm.test('Number of days matches request', function () {",
              "    const json = pm.response.json();",
              "    const expected = parseInt(pm.collectionVariables.get('days')) || 3;",
              "    pm.expect(json.daily.time.length).to.eql(expected);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrlForecast}}?latitude={{lat}}&longitude={{lon}}&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days={{days}}&timezone=auto",
          "host": ["{{baseUrlForecast}}"],
          "query": [
            { "key": "latitude", "value": "{{lat}}" },
            { "key": "longitude", "value": "{{lon}}" },
            {
              "key": "daily",
              "value": "temperature_2m_max,temperature_2m_min,precipitation_sum"
            },
            { "key": "forecast_days", "value": "{{days}}" },
            { "key": "timezone", "value": "auto" }
          ]
        },
        "description": "Получает прогноз погоды по координатам {{lat}}, {{lon}} на {{days}} дней. Возвращает массив дат, минимумов/максимумов температуры и осадков."
      },
      "response": [
        {
          "name": "Success 200 — прогноз получен",
          "originalRequest": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrlForecast}}?latitude=56.32694&longitude=44.00599&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days=3&timezone=auto",
              "host": ["{{baseUrlForecast}}"],
              "query": [
                { "key": "latitude", "value": "56.32694" },
                { "key": "longitude", "value": "44.00599" },
                {
                  "key": "daily",
                  "value": "temperature_2m_max,temperature_2m_min,precipitation_sum"
                },
                { "key": "forecast_days", "value": "3" },
                { "key": "timezone", "value": "auto" }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            { "key": "Content-Type", "value": "application/json; charset=utf-8" }
          ],
          "cookie": [],
          "body": "{\n  \"latitude\": 56.25,\n  \"longitude\": 44.0,\n  \"generationtime_ms\": 0.65,\n  \"utc_offset_seconds\": 10800,\n  \"timezone\": \"Europe/Moscow\",\n  \"timezone_abbreviation\": \"MSK\",\n  \"elevation\": 130.0,\n  \"daily_units\": {\n    \"time\": \"iso8601\",\n    \"temperature_2m_max\": \"°C\",\n    \"temperature_2m_min\": \"°C\",\n    \"precipitation_sum\": \"mm\"\n  },\n  \"daily\": {\n    \"time\": [\"2026-09-14\", \"2026-09-15\", \"2026-09-16\"],\n    \"temperature_2m_max\": [4.3, 5.1, 6.0],\n    \"temperature_2m_min\": [-2.1, -3.0, -1.5],\n    \"precipitation_sum\": [0.0, 0.2, 0.0]\n  }\n}"
        },
